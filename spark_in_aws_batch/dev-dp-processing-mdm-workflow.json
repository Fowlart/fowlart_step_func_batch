{
  "QueryLanguage": "JSONata",
  "StartAt": "IngestJob_1",
  "States": {
    "IngestJob_1": {
      "Type": "Task",
      "Resource": "arn:aws:states:::batch:submitJob.sync",
      "Arguments": {
        "JobName": "{% 'Ingest_' & $replace($substring($now(), 0, 19), ':', '-') %}",
        "JobDefinition": "arn:aws:batch:us-east-1:380078849537:job-definition/mdm-step1-ingest",
        "JobQueue": "arn:aws:batch:us-east-1:380078849537:job-queue/FowlartJobQueue",
        "ContainerOverrides": {
          "Command": [
            "s3_read_write_job.py",
            "s3a://fowlart-demo-bucket/raw_data/",
            "s3a://fowlart-demo-bucket/spark_output/"
          ]
        }
      },
      "Output": {
        "data_path": "s3a://fowlart-demo-bucket/spark_output/",
        "partition_n": "{% $states.input.n %}"
      },
      "Next": "RepartitionJob_2"
    },
    "RepartitionJob_2": {
      "Type": "Task",
      "Resource": "arn:aws:states:::batch:submitJob.sync",
      "Arguments": {
        "JobName": "{% 'Repartition_' & $replace($substring($now(), 0, 19), ':', '-') %}",
        "JobDefinition": "arn:aws:batch:us-east-1:380078849537:job-definition/mdm-step2-repartition",
        "JobQueue": "arn:aws:batch:us-east-1:380078849537:job-queue/FowlartJobQueue",
        "ContainerOverrides": {
          "Command": [
            "s3_read_repartition_write.py",
            "{% $string($states.input.partition_n) %}",
            "{% $states.input.data_path %}"
          ]
        }
      },
      "End": true
    }
  }
}