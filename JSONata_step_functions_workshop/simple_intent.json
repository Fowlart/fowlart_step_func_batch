{
  "Comment": "A description of my state machine",
  "StartAt": "Init state",
  "States": {
    "Init state": {
      "Type": "Pass",
      "Output": {
        "Phrase": "{% $states.input.input_a %}",
        "Number": "{% $states.input.input_b %}"
      },
      "Assign": {
        "the_int": "{%$states.input.input_b%}",
        "the_str": "{%$states.input.input_a%}"
      },
      "Next": "Main Choice"
    },
    "Main Choice": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "DetectSentiment",
          "Condition": "{%$number($the_int) >= 10%}"
        }
      ],
      "Default": "Fail"
    },
    "DetectSentiment": {
      "Type": "Task",
      "Comment": "The task of the `Request Response` pattern",
      "Arguments": {
        "LanguageCode": "en",
        "Text": "{%($the_str)%}"
      },
      "Resource": "arn:aws:states:::aws-sdk:comprehend:detectSentiment",
      "Next": "Success"
    },
    "Success": {
      "Type": "Succeed"
    },
    "Fail": {
      "Type": "Fail"
    }
  },
  "QueryLanguage": "JSONata"
}